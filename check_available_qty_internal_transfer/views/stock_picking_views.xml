<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Stock Move Line Detailed Operation Tree View (used in Detailed Operations tab) -->
    <record id="view_stock_move_line_detailed_operation_tree_inherit_check_available_qty" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit.check.available.qty</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_barcode" optional="show"/>
                <field name="is_excess_stock" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="available_qty" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit General Stock Move Line Tree View -->
    <record id="view_move_line_tree_inherit_check_available_qty" model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.check.available.qty</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_barcode" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="available_qty" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Primary Inherited Tree View for Excess Stock Input in Internal Transfer -->
    <record id="view_move_line_tree_excess_stock" model="ir.ui.view">
        <field name="name">stock.move.line.tree.excess.stock</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="replace">
                <tree string="Excess Stock Input in Internal Transfer" create="0" edit="0" delete="0">
                    <field name="date"/>
                    <field name="reference" string="Reference"/>
                    <field name="product_id"/>
                    <field name="product_barcode" optional="show"/>
                    <field name="lot_id" optional="hide"/>
                    <field name="available_qty" optional="show"/>
                    <field name="location_id"/>
                    <field name="location_dest_id"/>
                    <field name="qty_done"/>
                    <field name="product_uom_id" string="Unit of Measure" groups="uom.group_uom"/>
                    <field name="state" widget="badge" optional="show"/>
                </tree>
            </xpath>
        </field>
    </record>

    <!-- Action for Excess Stock Input in Internal Transfer -->
    <record id="action_excess_stock_input_internal_transfer" model="ir.actions.act_window">
        <field name="name">Excess Stock Input in Internal Transfer</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_excess_stock', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No move lines with excess stock input found!
            </p>
            <p>
                This menu displays internal transfer operations where the done quantity exceeds available stock.
            </p>
        </field>
    </record>

    <!-- Specify custom view mode tree action for excess stock action -->
    <record id="action_excess_stock_input_internal_transfer_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_move_line_tree_excess_stock"/>
        <field name="act_window_id" ref="action_excess_stock_input_internal_transfer"/>
    </record>

    <!-- Menuitem under Operations -->
    <menuitem id="menu_excess_stock_input_internal_transfer"
              name="Excess Stock Input in Internal Transfer"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_excess_stock_input_internal_transfer"
              sequence="150"/>
</odoo>
